# Oracle A1 VM Snatcher - Environment Configuration
# Copy this file to .env before deploying if you wish to configure defaults

# Web portal port
PORT=5000

# Optional Basic Auth password for Web UI (leave empty to disable authentication)
APP_PASSWORD=

# Maximum retry attempts before halting (default: 1000)
MAX_ATTEMPTS=1000

# Telegram Bot Token (pre-configured with requested bot token)
TELEGRAM_BOT_TOKEN=8662502307:AAF_5VwOGGK5tyEoEU6ujqcRLZulcgL9dXU

# Telegram Chat ID (leave empty or 'auto' to auto-detect from @cuanglabbot)
TELEGRAM_CHAT_ID=
